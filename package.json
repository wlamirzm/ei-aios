{
  "name": "ei-aios",
  "version": "1.0.0",
  "private": true,
  "description": "Energy Intelligence AI Operating System (EI-AIOS)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:agent": "npm run dev --workspace=@ei-aios/agent-core",
    "dev:web": "npm run dev --workspace=@ei-aios/web-ui",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}

