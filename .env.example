# ==========================================
# EI-AIOS Environment Variables
# ==========================================

# Server & Runtime
NODE_ENV=development
PORT=4000
DOMAIN=energyintel.local
WORKER_POLL_INTERVAL_MS=5000

# LLM Multi-Provider Configuration
LLM_PRIMARY_PROVIDER=bedrock
LLM_FALLBACK_ENABLED=true

# AWS Bedrock (Claude) — Primary
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
CLAUDE_DEFAULT_FAST_MODEL=claude-haiku-5-5
CLAUDE_DEFAULT_REASONING_MODEL=claude-sonnet-5-5

# Google Gemini API — Fallback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_DEFAULT_REASONING_MODEL=gemini-3.8-flash

# Supabase Persistence & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=ei-artifacts

# n8n Automation Engine
N8N_HOST=n8n.energyintel.local
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# Next.js Web UI
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_AGENT_CORE_URL=http://localhost:4000

# Production VPS & SSL
ACME_EMAIL=admin@energyintelligence.com.br

